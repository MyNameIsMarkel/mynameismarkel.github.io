---
/* Menú lateral. NOTAS se rellena solo con los .md de src/content/notes. */
import NavItem from './NavItem.astro';
import { buildNotesTree, type NavNode } from '../lib/nav';
import { norm } from '../lib/paths';
import { SITE } from '../data/site';
import { useT, type Lang } from '../i18n/ui';
import { localePath } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const NAV: NavNode[] = [
  { label: t('nav.about'),     level: 0, order: 0, href: localePath(lang, '') },
  { label: t('nav.notes'),     level: 0, order: 1, children: await buildNotesTree(lang) },
  { label: t('nav.projects'),  level: 0, order: 2, href: localePath(lang, 'projects/') },
  { label: t('nav.writeups'),  level: 0, order: 3, href: localePath(lang, 'writeups/') },
  { label: t('nav.templates'), level: 0, order: 4, href: localePath(lang, 'templates/') },
];

let current = norm(Astro.url.pathname);
// dentro de un proyecto / writeup concreto, marca su sección como activa
for (const section of ['projects/', 'writeups/']) {
  const base = norm(localePath(lang, section));
  if (current.startsWith(base)) current = base;
}
---
<div id="overlay" onclick="closeSidebar()"></div>
<nav id="sidebar" aria-label={t('menu.aria')}>
  <div class="sidebar-brand">
    <div class="brand-title">{SITE.name}</div>
    <div class="brand-sub">{t('site.subtitle')}</div>
  </div>
  <div class="nav-tree">
    {NAV.map((node) => (
      <div class="nav-section"><NavItem node={node} current={current} /></div>
    ))}
  </div>
  <div class="sidebar-footer">&copy; {new Date().getFullYear()} {SITE.name}<br />{t('site.footer')}</div>
</nav>
