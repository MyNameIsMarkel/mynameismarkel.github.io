---
import WriteupPage from '../../../views/WriteupPage.astro';
import { getWriteups } from '../../../lib/nav';

export async function getStaticPaths() {
  const writeups = await getWriteups('en');
  return writeups.map((writeup) => ({ params: { id: writeup.id }, props: { writeup } }));
}
const { writeup } = Astro.props;
---
<WriteupPage lang="en" writeup={writeup} />
