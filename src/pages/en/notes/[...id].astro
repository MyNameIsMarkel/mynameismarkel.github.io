---
/* Una página por cada nota: src/content/notes/tools/recon/nmap.md -> /en/notes/tools/recon/nmap/ */
import NotePage from '../../../views/NotePage.astro';
import { getNotes } from '../../../lib/nav';

export async function getStaticPaths() {
  const notes = await getNotes('en');
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}
const { note } = Astro.props;
---
<NotePage lang="en" note={note} />
