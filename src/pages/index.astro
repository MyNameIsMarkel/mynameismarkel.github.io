---
/* ABOUT ME — tu index.html original, solo envuelto en el layout común */
import Base from '../layouts/Base.astro';
---
<Base title="About me" breadcrumb={['ABOUT ME']} styles={['about.css']}
      description="Markel Iturbe — Cybersecurity professional: pentesting, IEC 62443, TISAX.">
  <div class="about-hero">
    <div>
      <div class="about-eyebrow">// Personal Portfolio</div>
      <h1 class="about-name">Markel<br><span>Iturbe</span></h1>
      <div class="about-role">Bachelor's Degree in Cybersecurity &amp; Higher Technician in Networked Computer Systems Administration.</div>
      <p class="about-bio">Cybersecurity professional with hands-on experience in penetration testing, industrial device security (IEC 62443), and regulatory compliance (TISAX). Background in systems and network administration, currently completing a Bachelor's Degree in Cybersecurity. Experienced in gap analysis, risk assessment, and audit management, with a strong focus on bridging technical security and compliance frameworks. Passionate about protecting industrial and corporate environments against evolving threats.</p>
      <div class="social-links">
        <a class="social-link" href="https://github.com/MyNameIsMarkel"><svg viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.37.6.1.82-.26.82-.58v-2.03c-3.34.73-4.04-1.6-4.04-1.6-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.48.99.1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 013-.4c1.02 0 2.04.13 3 .4 2.28-1.55 3.29-1.23 3.29-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.21.7.82.58A12.01 12.01 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>GitHub</a>
        <a class="social-link" href="https://www.linkedin.com/in/mynameismarkel/"><svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>LinkedIn</a>
        <a class="social-link" href="#"><svg viewBox="0 0 24 24"><path d="m22.5106 6.4566.0008-.0123a.888.888 0 0 0-.2717-.6384c-.0084-.0084-.018-.0155-.0267-.0235-.0186-.0166-.0371-.0333-.0572-.0484-.0193-.0147-.04-.0276-.0607-.0406-.0096-.006-.0182-.0131-.0281-.0188L12.4576.1266a.891.891 0 0 0-.9223.0043L1.933 5.6744c-.0107.0062-.0203.014-.0307.0205-.0073.0047-.015.008-.0223.0128-.007.0047-.013.0106-.02.0155a.8769.8769 0 0 0-.147.1333l-.0026.003a.8872.8872 0 0 0-.2218.5847l.0009.014c-.0002.0088-.0015.0176-.0015.0264v11.0708c0 .3277.1802.6288.469.7836l9.5986 5.5417c.0076.0044.0158.0075.0236.0117a.8754.8754 0 0 0 .166.0687c.0134.004.0266.0083.0401.0117a.8793.8793 0 0 0 .072.0142c.0117.0019.0232.0045.0349.006a.835.835 0 0 0 .2157 0c.0117-.0015.0232-.0041.0348-.006a.9.9 0 0 0 .072-.0142c.0135-.0034.0267-.0077.04-.0117a.895.895 0 0 0 .0646-.0217.9134.9134 0 0 0 .1015-.047c.0078-.0042.016-.0072.0236-.0117l9.5986-5.5417a.8888.8888 0 0 0 .469-.7836V6.4779c0-.0071-.0012-.0142-.0014-.0213zM5.2543 6.0822l6.5367-3.774a.4182.4182 0 0 1 .4182 0l6.5366 3.774a.4182.4182 0 0 1 0 .7243l-6.5367 3.774a.4182.4182 0 0 1-.4182 0l-6.5366-3.774a.4182.4182 0 0 1 0-.7243zm5.6134 14.3449a.4172.4172 0 0 1-.626.3613L3.718 17.0218a.4173.4173 0 0 1-.2086-.3613V9.1279a.4172.4172 0 0 1 .6258-.3613l6.524 3.7666a.4172.4172 0 0 1 .2086.3614v7.5325zm9.623-3.7666a.4173.4173 0 0 1-.2086.3613l-6.5239 3.7666a.4172.4172 0 0 1-.6259-.3613v-7.5325c0-.149.0796-.2868.2087-.3614l6.5239-3.7666a.4172.4172 0 0 1 .6258.3613v7.5326z"/></svg>Hack the box</a>
        <a class="social-link" href="mailto:mynameismarkel@gmail.com"><svg viewBox="0 0 24 24"><path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z"/></svg>Gmail</a>
      </div>
    </div>
    <div class="about-photo">
      <div class="photo-frame">
        <img src="/images/profile.jpg" alt="Markel Iturbe">
        <div class="photo-corner tl"></div>
        <div class="photo-corner br"></div>
      </div>
    </div>
  </div>

  <div class="section-header">
    <h2 class="section-label">Work Experience</h2>
    <div class="section-line"></div>
  </div>
  <div class="info-grid">
    <div class="info-card">
      <div class="card-eyebrow">September 2025 – June 2026</div>
      <div class="card-title">TISAX Compliance Technician</div>
      <div class="card-sub">RPK Group</div>
      <div class="card-desc">Conducted gap analyses against the TISAX framework, identifying and evaluating information security risks. Managed non-conformities throughout the audit process, coordinating corrective actions to ensure successful compliance outcomes.</div>
      <span class="card-tag">Internship</span><span class="card-tag gold">TISAX</span><span class="card-tag blue">Compliance</span><span class="card-tag blue">Gap Analysis</span><span class="card-tag blue">Risk Assessment</span><span class="card-tag blue">Non-Conformity Management</span><span class="card-tag blue">Audit Support</span><span class="card-tag blue">Information Security Management System</span>
    </div>
    <div class="info-card">
      <div class="card-eyebrow">January 2024 – April 2025</div>
      <div class="card-title">Cybersecurity Specialist</div>
      <div class="card-sub">Orbik Cybersecurity, Mondragon</div>
      <div class="card-desc">Performed penetration testing and robustness testing on industrial devices in accordance with the IEC/ISO 62443 standard. Also carried out assessments related to cyber resilience regulations, helping clients strengthen the security posture of their industrial systems.</div>
      <span class="card-tag">Full-time</span><span class="card-tag gold">IEC/ISO 62443</span><span class="card-tag gold">Cyber Resilience Act (CRA)</span><span class="card-tag gold">Industrial Cybersecurity (OT)</span><span class="card-tag blue">Client Communication</span><span class="card-tag blue">Penetration Testing</span><span class="card-tag blue">Robustness Testing</span><span class="card-tag blue">Vulnerability Assessment</span><span class="card-tag blue">Embedded Device Security Testing</span>
    </div>
    <div class="info-card">
      <div class="card-eyebrow">March 2023 – May 2023</div>
      <div class="card-title">Business and Technology Consultant</div>
      <div class="card-sub">Entelgy Innotec Security, Vitoria</div>
      <div class="card-desc">Provided customer support while monitoring and identifying fraudulent online activities. Documented and reported security incidents in a structured manner, contributing to faster response times and improved client protection.</div>
      <span class="card-tag">Internship</span><span class="card-tag blue">Customer Support</span><span class="card-tag blue">Phishing Detection</span><span class="card-tag blue">Fraud Analysis</span><span class="card-tag blue">Incident Reporting</span><span class="card-tag blue">Threat Monitoring</span>
    </div>
    <div class="info-card">
      <div class="card-eyebrow">March 2022 – June 2022</div>
      <div class="card-title">Marketing Manager &amp; Developer</div>
      <div class="card-sub">Selpath Technologies, Bilbao</div>
      <div class="card-desc">Responsible for the design and development of software solutions with a strong focus on security, ensuring that products were built following secure development principles from the earliest stages.</div>
      <span class="card-tag">Internship</span><span class="card-tag gold">Python</span><span class="card-tag gold">JavaScript</span><span class="card-tag blue">Secure Software Development</span><span class="card-tag blue">Security by Design</span><span class="card-tag blue">Software Engineering</span>
    </div>
  </div>

  <div class="section-header">
    <h2 class="section-label">Education</h2>
    <div class="section-line"></div>
  </div>
  <div class="info-grid">
    <div class="info-card">
      <div class="card-eyebrow">Ongoing</div>
      <div class="card-title">Bachelor's Degree in Cybersecurity</div>
      <div class="card-sub">EUNEIZ University, Vitoria</div>
      <div class="card-desc">Degree focused on the prevention, detection, and mitigation of security incidents, covering ethical hacking, digital forensics, secure development, risk management, threat intelligence, and cybersecurity governance and compliance.</div>
      <span class="card-tag">Bachelor's Degree</span><span class="card-tag blue">Malware Analysis</span><span class="card-tag blue">Cryptography</span><span class="card-tag blue">Penetration Testing</span><span class="card-tag blue">Industrial Cybersecurity</span><span class="card-tag blue">Risk Management</span><span class="card-tag blue">Threat Intelligence</span><span class="card-tag blue">AI for Cybersecurity</span><span class="card-tag blue">Governance &amp; Standards</span><span class="card-tag blue">Cloud Security</span><span class="card-tag blue">Red Team &amp; Blue Team</span>
    </div>
    <div class="info-card">
      <div class="card-eyebrow">June 2023</div>
      <div class="card-title">Higher Vocational Degree in Cybersecurity in Information Technology Environments</div>
      <div class="card-sub">Maristas Durango</div>
      <div class="card-desc">Official specialization in cybersecurity covering incident response, system and network hardening, ethical hacking, digital forensics, secure deployment, and security regulations, completed with dual work-based training in industry.</div>
      <span class="card-tag">Advanced Specialization Program</span><span class="card-tag blue">Cybersecurity Incidents</span><span class="card-tag blue">Network &amp; System Hardening</span><span class="card-tag blue">Ethical Hacking</span><span class="card-tag blue">Security Regulations</span><span class="card-tag blue">Core Fundamentals</span><span class="card-tag blue">Secure DevOps</span><span class="card-tag blue">Digital Forensics</span>
    </div>
    <div class="info-card">
      <div class="card-eyebrow">June 2022</div>
      <div class="card-title">Higher Vocational Degree in Networked Computer Systems Administration</div>
      <div class="card-sub">Mondragon Higher Polytechnic School</div>
      <div class="card-desc">Vocational degree focused on the administration of networked computer systems: configuration, maintenance, and security of servers, networks, operating systems, and databases.</div>
      <span class="card-tag">Higher Vocational Degree</span><span class="card-tag blue">Systems Administration</span><span class="card-tag blue">Network Administration</span><span class="card-tag blue">DB Management</span><span class="card-tag blue">Web Services &amp; Applications</span><span class="card-tag blue">Security &amp; High Availability</span><span class="card-tag blue">Hardware Fundamentals</span>
    </div>
  </div>

  <div class="section-header">
    <h2 class="section-label">Certifications</h2>
    <div class="section-line"></div>
  </div>
  <div class="info-grid">
    <div class="info-card">
      <div class="card-eyebrow">2018</div>
      <div class="card-title">B2 First Certificate</div>
      <div class="card-sub">University of Cambridge</div>
      <span class="card-tag">English</span>
    </div>
  </div>

  <div class="section-header">
    <h2 class="section-label">Languages</h2>
    <div class="section-line"></div>
  </div>
  <div class="lang-list">
    <div class="lang-item">
      <span class="lang-name">Español</span>
      <div class="lang-bar-wrap"><div class="lang-bar" style="width:100%"></div></div>
      <span class="lang-level">Nativo</span>
    </div>
    <div class="lang-item">
      <span class="lang-name">Euskera</span>
      <div class="lang-bar-wrap"><div class="lang-bar" style="width:100%"></div></div>
      <span class="lang-level">Nativo</span>
    </div>
    <div class="lang-item">
      <span class="lang-name">Inglés</span>
      <div class="lang-bar-wrap"><div class="lang-bar" style="width:80%"></div></div>
      <span class="lang-level">B2 First</span>
    </div>
  </div>
</Base>
