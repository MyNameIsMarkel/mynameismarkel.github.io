---
/* PROJECTS — las tarjetas se generan solas con los .md de src/content/projects */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/paths';
import { tagInfo } from '../../lib/tags';

const projects = (await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'es'));

const ACCENT = {
  red:  'linear-gradient(to right, var(--red), var(--gold))',
  blue: 'linear-gradient(to right, var(--blue), var(--gold))',
};
const year = new Date().getFullYear();
---
<Base title="Projects" breadcrumb={['PROJECTS']}>
  <div class="page-hero">
    <div class="page-eyebrow">// Work</div>
    <h1 class="page-title">PROJECTS</h1>
    <div class="page-subtitle">Última actualización: {year}</div>
  </div>
  <div class="projects-grid">
    {projects.map((p, i) => (
      <a class="project-card" href={url(`projects/${p.id}/`)}>
        <div class="project-accent" style={`background: ${ACCENT[p.data.accent]}`}></div>
        <div class="project-body">
          <div class="project-number">{String(i + 1).padStart(2, '0')}</div>
          <div class="project-title">{p.data.title}</div>
          <div class="project-desc">{p.data.description}</div>
          <div class="project-tags">
            {p.data.tags.map((t) => { const { label, cls } = tagInfo(t); return <span class={`card-tag ${cls}`}>{label}</span>; })}
          </div>
        </div>
      </a>
    ))}
  </div>
</Base>
