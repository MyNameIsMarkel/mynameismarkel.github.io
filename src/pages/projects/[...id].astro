---
import ProjectPage from '../../views/ProjectPage.astro';
import { getProjects } from '../../lib/nav';

export async function getStaticPaths() {
  const projects = await getProjects('es');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
---
<ProjectPage lang="es" project={project} />
