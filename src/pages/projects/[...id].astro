---
/* Página de detalle de cada proyecto */
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/paths';
import { tagInfo } from '../../lib/tags';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<Base title={project.data.title} breadcrumb={['PROJECTS', project.data.title]} description={project.data.description}>
  <div class="page-hero gold-accent">
    <div class="page-eyebrow gold">// Project</div>
    <h1 class="page-title">{project.data.title}</h1>
    <div class="page-subtitle">{project.data.description}</div>
    <div class="page-tags">
      {project.data.tags.map((t) => { const { label, cls } = tagInfo(t); return <span class={`card-tag ${cls}`}>{label}</span>; })}
    </div>
    {project.data.repo && <a class="project-link" href={project.data.repo} target="_blank" rel="noopener">→ Ver en GitHub</a>}
  </div>
  <article class="note-body">
    <Content />
  </article>
  <a class="back-link" href={url('projects/')}>← Volver a proyectos</a>
</Base>
