---
/* SOBRE MÍ / ABOUT ME — el contenido se edita en src/data/profile.ts */
import Base from '../layouts/Base.astro';
import { tr, useT, type Lang } from '../i18n/ui';
import { HERO, LINKS, SECTIONS, EXPERIENCE, EDUCATION, CERTIFICATIONS, LANGUAGES, type Card } from '../data/profile';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const T = (v: Parameters<typeof tr>[0]) => tr(v, lang);

const groups: { title: Parameters<typeof tr>[0]; cards: Card[] }[] = [
  { title: SECTIONS.experience, cards: EXPERIENCE },
  { title: SECTIONS.education, cards: EDUCATION },
  { title: SECTIONS.certifications, cards: CERTIFICATIONS },
];
const ext = { target: '_blank', rel: 'noopener' };
---
<Base lang={lang} title={t('nav.about')} breadcrumb={[t('nav.about')]} styles={['about.css']}
      description={`${HERO.firstName} ${HERO.lastName} — ${T(HERO.role)}`}>
  <div class="about-hero">
    <div>
      <div class="about-eyebrow">// {T(HERO.eyebrow)}</div>
      <h1 class="about-name">{HERO.firstName}<br><span>{HERO.lastName}</span></h1>
      <div class="about-role">{T(HERO.role)}</div>
      <p class="about-bio">{T(HERO.bio)}</p>
      <div class="social-links">
        <a class="social-link" href={LINKS.github} {...ext}><svg viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.37.6.1.82-.26.82-.58v-2.03c-3.34.73-4.04-1.6-4.04-1.6-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.48.99.1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 013-.4c1.02 0 2.04.13 3 .4 2.28-1.55 3.29-1.23 3.29-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.21.7.82.58A12.01 12.01 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>GitHub</a>
        <a class="social-link" href={LINKS.linkedin} {...ext}><svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>LinkedIn</a>
        <a class="social-link" href={LINKS.hackthebox} {...ext}><svg viewBox="0 0 24 24"><path d="m22.5106 6.4566.0008-.0123a.888.888 0 0 0-.2717-.6384c-.0084-.0084-.018-.0155-.0267-.0235-.0186-.0166-.0371-.0333-.0572-.0484-.0193-.0147-.04-.0276-.0607-.0406-.0096-.006-.0182-.0131-.0281-.0188L12.4576.1266a.891.891 0 0 0-.9223.0043L1.933 5.6744c-.0107.0062-.0203.014-.0307.0205-.0073.0047-.015.008-.0223.0128-.007.0047-.013.0106-.02.0155a.8769.8769 0 0 0-.147.1333l-.0026.003a.8872.8872 0 0 0-.2218.5847l.0009.014c-.0002.0088-.0015.0176-.0015.0264v11.0708c0 .3277.1802.6288.469.7836l9.5986 5.5417c.0076.0044.0158.0075.0236.0117a.8754.8754 0 0 0 .166.0687c.0134.004.0266.0083.0401.0117a.8793.8793 0 0 0 .072.0142c.0117.0019.0232.0045.0349.006a.835.835 0 0 0 .2157 0c.0117-.0015.0232-.0041.0348-.006a.9.9 0 0 0 .072-.0142c.0135-.0034.0267-.0077.04-.0117a.895.895 0 0 0 .0646-.0217.9134.9134 0 0 0 .1015-.047c.0078-.0042.016-.0072.0236-.0117l9.5986-5.5417a.8888.8888 0 0 0 .469-.7836V6.4779c0-.0071-.0012-.0142-.0014-.0213zM5.2543 6.0822l6.5367-3.774a.4182.4182 0 0 1 .4182 0l6.5366 3.774a.4182.4182 0 0 1 0 .7243l-6.5367 3.774a.4182.4182 0 0 1-.4182 0l-6.5366-3.774a.4182.4182 0 0 1 0-.7243zm5.6134 14.3449a.4172.4172 0 0 1-.626.3613L3.718 17.0218a.4173.4173 0 0 1-.2086-.3613V9.1279a.4172.4172 0 0 1 .6258-.3613l6.524 3.7666a.4172.4172 0 0 1 .2086.3614v7.5325zm9.623-3.7666a.4173.4173 0 0 1-.2086.3613l-6.5239 3.7666a.4172.4172 0 0 1-.6259-.3613v-7.5325c0-.149.0796-.2868.2087-.3614l6.5239-3.7666a.4172.4172 0 0 1 .6258.3613v7.5326z"/></svg>Hack the box</a>
        <a class="social-link" href={`mailto:${LINKS.email}`}><svg viewBox="0 0 24 24"><path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z"/></svg>Gmail</a>
      </div>
    </div>
    <div class="about-photo">
      <div class="photo-frame">
        {HERO.photo ? (
          <img src={HERO.photo} alt={`${HERO.firstName} ${HERO.lastName}`} />
        ) : (
          <div class="photo-placeholder"><svg width="48" height="48" viewBox="0 0 48 48" fill="none"><circle cx="24" cy="18" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M6 42c0-9.94 8.06-18 18-18s18 8.06 18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Profile picture</span></div>
        )}
        <div class="photo-corner tl"></div>
        <div class="photo-corner br"></div>
      </div>
    </div>
  </div>

  {groups.map((g) => (
    <>
      <div class="section-header">
        <h2 class="section-label">{T(g.title)}</h2>
        <div class="section-line"></div>
      </div>
      <div class="info-grid">
        {g.cards.map((c) => (
          <div class="info-card">
            <div class="card-eyebrow">{T(c.date)}</div>
            <div class="card-title">{T(c.title)}</div>
            <div class="card-sub">{T(c.place)}</div>
            {c.desc && <div class="card-desc">{T(c.desc)}</div>}
            {c.tags.map((tag) => <span class={`card-tag ${tag.color === 'red' ? '' : tag.color}`}>{T(tag.text)}</span>)}
          </div>
        ))}
      </div>
    </>
  ))}

  <div class="section-header">
    <h2 class="section-label">{T(SECTIONS.languages)}</h2>
    <div class="section-line"></div>
  </div>
  <div class="lang-list">
    {LANGUAGES.map((l) => (
      <div class="lang-item">
        <span class="lang-name">{T(l.name)}</span>
        <div class="lang-bar-wrap"><div class="lang-bar" style={`width:${l.level}%`}></div></div>
        <span class="lang-level">{T(l.label)}</span>
      </div>
    ))}
  </div>
</Base>
