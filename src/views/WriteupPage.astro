---
/* Página de un walkthrough de HTB (los dos idiomas) */
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import type { WriteupItem } from '../lib/nav';
import { tagInfo } from '../lib/tags';
import { DIFF_TAG, OS_ICON } from '../lib/writeups';
import { useT, dateLocale, type Lang, type UIKey } from '../i18n/ui';
import { localePath } from '../i18n/utils';

interface Props { lang: Lang; writeup: WriteupItem }
const { lang, writeup } = Astro.props;
const t = useT(lang);
const d = writeup.entry.data;
const { Content } = await render(writeup.entry);
const date = d.date.toLocaleDateString(dateLocale(lang), { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base lang={lang} title={writeup.title} breadcrumb={[t('nav.writeups'), writeup.title]} description={d.description}>
  <div class="page-hero">
    <div class="page-eyebrow">// {t('writeup.eyebrow')} · Hack The Box</div>
    <h1 class="page-title">{writeup.title}</h1>
    {d.description && <div class="page-subtitle">{d.description}</div>}
    <div class="page-subtitle">{t('writeup.completed')}: {date}</div>
    <div class="page-tags">
      <span class="card-tag blue">{OS_ICON[d.os]} {d.os}</span>
      <span class={`card-tag ${DIFF_TAG[d.difficulty]}`}>{t(`diff.${d.difficulty}` as UIKey)}</span>
      {d.tags.map((tg) => { const { label, cls } = tagInfo(tg); return <span class={`card-tag ${cls}`}>{label}</span>; })}
    </div>
    {d.url && <a class="project-link" href={d.url} target="_blank" rel="noopener">→ {t('writeup.machine')}</a>}
  </div>
  {!d.retired && <div class="lang-notice">{t('writeup.active')}</div>}
  {writeup.fallback && <div class="lang-notice">{t('writeup.fallback')}</div>}
  <article class="note-body">
    <Content />
  </article>
  <a class="back-link" href={localePath(lang, 'writeups/')}>← {t('writeup.back')}</a>
</Base>
